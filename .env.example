# ============================================================================
#  Единый файл настроек. Скопируйте в .env:  cp .env.example .env
#  Все значения ниже — только для локального демо, НЕ для production.
# ============================================================================

# ---------- Общие ----------
COMPOSE_PROJECT_NAME=grocery
TZ=Asia/Vladivostok

# ---------- ClickHouse ----------
CLICKHOUSE_DB=grocery
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_secret
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_SECURE=false
# порты, публикуемые на хост
CLICKHOUSE_HTTP_PORT_HOST=8123
CLICKHOUSE_NATIVE_PORT_HOST=9000

# ---------- Генератор данных ----------
GENERATOR_SEED=42
# пауза между тиками генерации, сек
GENERATOR_INTERVAL_SECONDS=2
# максимум чеков в одном тике
GENERATOR_BATCH_SIZE=20
# базовая интенсивность потока, чеков в минуту (до сезонных множителей)
GENERATOR_ORDERS_PER_MINUTE=60
# вероятность аномалии на чек и её сила (множитель)
GENERATOR_ANOMALY_PROBABILITY=0.005
GENERATOR_ANOMALY_STRENGTH=3
GENERATOR_STORE_COUNT=6
GENERATOR_PRODUCT_COUNT=90
# сколько часов истории сгенерировать при первом старте (0 — не генерировать)
GENERATOR_BACKFILL_HOURS=24
# retry при недоступности ClickHouse
GENERATOR_RETRY_MAX_ATTEMPTS=5
GENERATOR_HEALTH_PORT=8080
LOG_LEVEL=INFO
